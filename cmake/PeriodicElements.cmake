# 浏览器与 C++ 从同一个受版本管理的数据块读取元素事实，不维护两套名单。
set(_elements_path "${CMAKE_CURRENT_SOURCE_DIR}/public/periodic-elements-data.js")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_elements_path}")
file(READ "${_elements_path}" _elements_script)
foreach(_marker BEGIN END)
    string(REGEX MATCHALL "GY_ELEMENTS_JSON_${_marker}" _matches "${_elements_script}")
    list(LENGTH _matches _count)
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "元素数据块 ${_marker} 标记缺失或重复")
    endif()
endforeach()
set(_begin "/* GY_ELEMENTS_JSON_BEGIN */")
set(_end "/* GY_ELEMENTS_JSON_END */")
string(FIND "${_elements_script}" "${_begin}" _start)
string(LENGTH "${_begin}" _begin_length)
math(EXPR _start "${_start} + ${_begin_length}")
string(FIND "${_elements_script}" "${_end}" _finish)
math(EXPR _length "${_finish} - ${_start}")
if(_length LESS 1)
    message(FATAL_ERROR "元素数据块顺序无效")
endif()
string(SUBSTRING "${_elements_script}" ${_start} ${_length} _elements_json)
string(STRIP "${_elements_json}" _elements_json)
string(JSON _elements_count LENGTH "${_elements_json}" elements)
if(NOT _elements_count EQUAL 118)
    message(FATAL_ERROR "元素资料须包含已注册的 118 种元素")
endif()
foreach(_index RANGE 0 117)
    string(JSON _atomic_number GET "${_elements_json}" elements ${_index} atomicNumber)
    math(EXPR _expected "${_index} + 1")
    if(NOT _atomic_number EQUAL _expected)
        message(FATAL_ERROR "元素原子序数缺失或顺序不正确")
    endif()
endforeach()
string(FIND "${_elements_json}" ")GY_ELEMENTS\"" _delimiter)
if(NOT _delimiter EQUAL -1)
    message(FATAL_ERROR "元素数据含不允许的嵌入分隔符")
endif()
string(JSON _dataset_id GET "${_elements_json}" id)
if(NOT _dataset_id MATCHES "^[a-z0-9-]+$")
    message(FATAL_ERROR "元素资料版本无效")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/periodic_elements_data.tmp"
    "#pragma once\nnamespace gangyi {\ninline constexpr char kPeriodicElementsId[] = \"${_dataset_id}\";\ninline constexpr char kPeriodicElementsJson[] = u8R\"GY_ELEMENTS(${_elements_json})GY_ELEMENTS\";\n}\n")
configure_file("${CMAKE_CURRENT_BINARY_DIR}/generated/periodic_elements_data.tmp"
               "${CMAKE_CURRENT_BINARY_DIR}/generated/periodic_elements_data.hpp" COPYONLY)
