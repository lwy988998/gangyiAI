{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "一元一次方程变形状态 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "value"
        ],
        "properties": {
          "op": {
            "enum": [
              "add_x",
              "add_constant",
              "multiply",
              "divide"
            ]
          },
          "value": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "enum": [
                    "multiply",
                    "divide"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "description": "学生只能提交受限等价步骤；原题和所有计算结果由当前课件及服务端重放决定。数值中间值/变形结果上限另由计算器校验。"
}
