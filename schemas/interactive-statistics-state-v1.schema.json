{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "描述统计探索状态 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "values",
    "varianceBasis"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "number",
        "minimum": -100,
        "maximum": 100,
        "multipleOf": 0.5
      }
    },
    "varianceBasis": {
      "enum": [
        "population",
        "sample"
      ]
    }
  },
  "description": "保留重复值，只提交当前数据与方差口径；统计结果由服务端重算，探索不评分。"
}
